{
  "name": "integration-tests-jest",
  "version": "1.0.0",
  "description": "API testing with a simple integration between JestJS and PactumJS.",
  "main": "index.js",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@napi-rs/canvas": "^1.0.9",
    "@sonar/scan": "^5.0.1",
    "@tesseract.js-data/por": "^1.0.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.5.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.2.0",
    "jest": "^30.4.2",
    "jest-html-reporters": "^3.1.7",
    "mkdirp": "^3.0.1",
    "multer": "^2.0.2",
    "pactum": "^3.9.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "tesseract.js": "^7.0.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.20.5",
    "typescript": "5.5.4",
    "zod": "^4.1.8"
  },
  "scripts": {
    "clean": "rimraf ./output && mkdirp ./output",
    "format": "prettier --write \"**/*.{js,cjs,ts,tsx}\"",
    "verify": "prettier --check \"**/*.{js,cjs,ts,tsx}\"",
    "eslint": "eslint \"**/*.{js,cjs,ts,tsx}\" -o output/eslint.html -f html",
    "api": "cd api/carga-facil && node --import tsx prova-server.ts",
    "scenario": "node scripts/run-scenario.cjs",
    "test:prova": "npm run scenario",
    "typecheck": "tsc --noEmit",
    "sonar": "node scripts/sonar.cjs",
    "test": "node scripts/run-scenario.cjs",
    "test:external": "jest --config ./jest.external.config.js",
    "ci": "npm run clean && npm run verify && npm run eslint && npm run typecheck && npm run test:prova"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugioni/integration-tests-jest.git"
  },
  "author": "leandro.ugioni",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ugioni/integration-tests-jest/issues"
  },
  "homepage": "https://github.com/ugioni/integration-tests-jest#readme"
}
